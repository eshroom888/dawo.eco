{
  "version": "2026-02",
  "description": "Rate limit and quota configuration for DAWO services",

  "instagram_api": {
    "quota_limit_per_hour": 200,
    "publish_timeout_seconds": 30,
    "max_caption_length": 2200,
    "max_hashtags": 30,
    "latency_target_seconds": 30.0,
    "success_rate_threshold": 99.0,
    "failure_threshold": 3,
    "metrics_window_size": 1000
  },

  "websocket": {
    "max_queue_size": 100,
    "max_subscribers": 100
  },

  "notifications": {
    "cooldown_minutes": 60,
    "batch_window_minutes": 15,
    "daily_summary_hour": 22,
    "pending_queue_ttl_hours": 24,
    "max_retry_attempts": 5,
    "backoff_schedule_seconds": [60, 300, 900, 3600]
  },

  "discord_webhook": {
    "max_requests_per_second": 5,
    "burst_limit": 50,
    "reset_window_seconds": 60
  },

  "scheduling": {
    "max_posts_per_day": 10,
    "max_posts_per_slot": 1,
    "min_hours_between_posts": 2,
    "business_hours_start": 8,
    "business_hours_end": 22
  },

  "gmail": {
    "max_per_minute": 20,
    "max_per_day": 500,
    "burst_size": 5,
    "business_hours": {
      "start": 8,
      "end": 17,
      "timezone": "Europe/Oslo"
    }
  }
}
